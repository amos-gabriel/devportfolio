{
  "homepage": "https://amos-gabriel.github.io/devportfolio/",
  "name": "amosgabrieldev",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@splinetool/react-spline": "^4.1.0",
    "@splinetool/runtime": "^1.10.80",
    "colorthief": "^2.3.0",
    "framer-motion": "^10.16.0",
    "gh-pages": "^6.3.0",
    "lottie-react": "^2.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-easy-emoji": "^1.8.1",
    "react-headroom": "^3.0.0",
    "react-twitter-embed": "4.0.4",
    "sass": "^1.32.8"
  },
  "scripts": {
    "predeploy": "npm run build",
    "fetch": "node fetch.js",
    "dev": "npm run fetch && webpack serve --config webpack.dev.js",
    "dev:watch": "nodemon --exec \"webpack serve --config webpack.dev.js\" --ignore public/",
    "start": "node fetch.js && webpack serve --config webpack.dev.js",
    "build": "node fetch.js && webpack --config webpack.prod.js",
    "deploy": "gh-pages -b gh-pages -d build",
    "format": "prettier --write \"./**/*.{js,css,json,scss}\"",
    "check-format": "prettier -c \"./**/*.{js,css,json,scss}\""
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.3%",
      "not ie 11",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      ">0.3%",
      "not ie 11",
      "not dead",
      "not op_mini all",
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@babel/preset-env": "^7.22.0",
    "@babel/preset-react": "^7.22.0",
    "babel-loader": "^9.1.0",
    "css-loader": "^7.1.2",
    "dotenv": "^8.2.0",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.5.0",
    "mini-css-extract-plugin": "^2.7.0",
    "nodemon": "^3.0.0",
    "prettier": "^2.3.1",
    "sass-loader": "^16.0.0",
    "style-loader": "^3.3.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^5.2.2",
    "webpack-merge": "^5.9.0"
  }
}
